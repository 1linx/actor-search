# Either works — the app detects which one you've supplied.
#
#  - v3 API key: the short hex string from
#    https://www.themoviedb.org/settings/api ("API Key")
#  - v4 read access token: the long JWT on the same page
#    ("API Read Access Token") — set TMDB_READ_ACCESS_TOKEN instead
TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=

# Optional but recommended: keeps auth sessions valid across restarts.
# Any long random string, e.g. `openssl rand -hex 32`.
AUTH_SECRET=
